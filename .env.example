# ===========================================
# HanziMaster Portal V2 - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ------------------------------------------
# Clerk Authentication (Required)
# ------------------------------------------
# Get your keys from: https://dashboard.clerk.com → API Keys
# 
# For development, use your test key (pk_test_...)
# For production, use your live key (pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ------------------------------------------
# Backend API URL (Required)
# ------------------------------------------
# Local development: http://localhost:8787
# Production: Your deployed backend URL
VITE_API_URL=http://localhost:8787

# ------------------------------------------
# Optional: Feature Flags
# ------------------------------------------
# Enable debug logging in production (not recommended)
# VITE_DEBUG=false
